# このファイルをコピーして .env を作成する:  cp .env.example .env
# SESSION_SECRET は必ず自分で生成する:        openssl rand -base64 32

# ローカル Docker の MySQL（compose.yml と一致させる）
DATABASE_URL="mysql://tech_blog:tech_blog@localhost:3306/tech_blog"

# セッション Cookie（JWT）の署名鍵。32 バイト以上のランダム文字列。
SESSION_SECRET="replace-me-with-openssl-rand-base64-32"

# 初期管理者。prisma db seed でこの資格情報のユーザーを 1 件作成する。
ADMIN_EMAIL="admin@aship.local"
ADMIN_PASSWORD="changeme-dev-only"
